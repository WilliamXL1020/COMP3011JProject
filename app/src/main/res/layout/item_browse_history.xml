<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Video Cover -->
    <ImageView
        android:id="@+id/iv_video_cover"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@drawable/default_avatar" />

    <!-- Information area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <!-- Video title -->
        <TextView
            android:id="@+id/tv_video_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Video title"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="top" />

        <!-- Category and viewing time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Classification"
                android:textSize="12sp"
                android:textColor="#666666"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_watch_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="just"
                android:textSize="11sp"
                android:textColor="#999999" />

        </LinearLayout>

        <!-- Viewing duration and location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_watch_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Watch for 10 seconds"
                android:textSize="11sp"
                android:textColor="#999999" />

            <TextView
                android:id="@+id/tv_last_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue watching"
                android:textSize="11sp"
                android:textColor="@color/red"
                android:background="@color/black"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/btn_delete_history"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_delete"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="delete history"
        android:layout_marginStart="8dp" />

</LinearLayout>