<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:fitsSystemWindows="false">


    <include layout="@layout/toolbar" />

    <!-- 播放器视图 -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:fitsSystemWindows="false"
        app:use_controller="true"
        app:auto_show="true" >

        <ImageButton
            android:id="@+id/btn_custom_fullscreen"
            android:layout_width="40dp"
            android:layout_height="35dp"
            android:layout_gravity="center|right"
            android:layout_margin="16dp"
            android:background="@drawable/ic_fullscreen"
            android:contentDescription="full screen"
            android:visibility="visible" />
        <ImageButton
            android:id="@+id/btn_custom_back"
            android:layout_width="40dp"
            android:layout_height="35dp"
            android:layout_gravity="top|left"
            android:layout_margin="16dp"
            android:background="@drawable/ic_arrow_back"
            android:contentDescription="return"
            android:visibility="visible" />
    </com.google.android.exoplayer2.ui.PlayerView>


    <LinearLayout
        android:id="@+id/video_info_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Video title -->
                <TextView
                    android:id="@+id/tv_video_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Video title"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Uploader information -->
                <TextView
                    android:id="@+id/tv_video_uploader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Uploader: Unknown"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_video_uploadtime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload time"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <!-- Playback statistics -->
                <TextView
                    android:id="@+id/tv_video_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Views: 0 | Likes: 0"
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <!-- Video description -->
                <TextView
                    android:id="@+id/tv_video_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Video size"
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/tv_video_resolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="resolution"
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/tv_video_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Video description information..."
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:id="@+id/tv_video_catagory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Label"
                    android:textColor="@android:color/black"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recommendations_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:background="@color/list_background">

        <!-- Recommended title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Recommended Videos"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="10dp" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_recommend"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4">

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recommendations"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</LinearLayout>